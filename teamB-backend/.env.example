# ---------------------------------------------------------------------------
# Smart Academic Advisor — Team B Backend — environment example
# Copy to .env and fill real values. NEVER commit a real .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# MySQL (Prisma). Format: mysql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="mysql://root:change_me@localhost:3306/smart_advisor"

# JWT — generate long random strings (min 32 chars enforced by env validation)
JWT_ACCESS_SECRET=replace-with-a-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-plus-char-random-secret
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES_DAYS=7

# Password hashing cost
BCRYPT_ROUNDS=10

# Email domain allowed for self-service registration (empty disables the check)
ALLOWED_EMAIL_DOMAIN=bua.edu.eg

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Logging level used by morgan (tiny|short|dev|combined)
LOG_LEVEL=combined

# Seed script (demonstration accounts). Default password for seeded users.
DEMO_PASSWORD=ChangeMe!2026
