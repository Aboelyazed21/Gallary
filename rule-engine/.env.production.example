# Production environment (rule-engine) — cut from docker-compose.yml + app/config.py
# Copy these as Variables in Railway/Render (values are secrets — never commit .env).

APP_ENV=production
DATABASE_URL=postgresql://smart_advisor_app:<DB_APP_PASSWORD>@<supabase-host>:5432/postgres?sslmode=require
ENGINE_SERVICE_TOKEN=<same as backend-api>
ENGINE_HMAC_SECRET=<same as backend-api>
POLICY_INGEST_ON_START=true
RAG_MIN_CONFIDENCE=0.32
RAG_TOP_K=5

# LLM (optional — without it answers fall back to extractive)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=18
RAG_GENERATE=true

LOG_LEVEL=INFO
