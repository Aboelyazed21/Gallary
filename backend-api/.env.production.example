# Production environment (backend-api) — cut from docker-compose.yml + env.ts
# Copy these as Variables in Railway/Render (values are secrets — never commit .env).

NODE_ENV=production
PORT=4000

# Supabase Postgres (session-pooler URI, URL-encoded password)
DATABASE_URL=postgresql://smart_advisor_app:<DB_APP_PASSWORD>@<supabase-host>:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres:<supabase-password>@<supabase-host>:5432/postgres?sslmode=require
DB_APP_PASSWORD=<32+ random chars>

JWT_ACCESS_SECRET=<32+ random chars>
JWT_REFRESH_PEPPER=<32+ random chars>
JWT_ISSUER=bua-aidm-advisor
JWT_AUDIENCE=bua-aidm-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

ENGINE_URL=https://<rule-engine-domain>        # public URL of the rule-engine service
ENGINE_SERVICE_TOKEN=<32+ random chars>
ENGINE_HMAC_SECRET=<32+ random chars>
ENGINE_TIMEOUT_MS=30000

ALLOWED_EMAIL_DOMAIN=bua.edu.eg               # covers @aidm.bua.edu.eg + @bua.edu.eg
CORS_ORIGINS=https://front-end-smart-acadmic-ad.vercel.app
COOKIE_SECURE=true
TRUST_PROXY=loopback

SMTP_HOST=<optional smtp>
SMTP_PORT=1025
SMTP_FROM=no-reply@aidm.bua.edu.eg
APP_BASE_URL=https://front-end-smart-acadmic-ad.vercel.app
QR_SIGNING_SECRET=<32+ random chars>
DEMO_PASSWORD=ChangeMe!2026

RUN_MIGRATIONS=true
RUN_SEED=true
SEED_DEMO=true                                 # seeds the test accounts (ChangeMe!2026)

# LLM (optional — without it answers fall back to extractive)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=18
RAG_GENERATE=true
